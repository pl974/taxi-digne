---
/**
 * Composant FeatureGrid - Grille de features/avantages
 * Supporte images ou icônes SVG
 */

interface Feature {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  icon?: string; // HTML SVG ou emoji (si besoin icon)
}

interface Props {
  title?: string;
  subtitle?: string;
  features: Feature[];
  columns?: 2 | 3 | 4;
  variant?: 'image' | 'icon' | 'minimal';
}

const {
  title,
  subtitle,
  features,
  columns = 3,
  variant = 'image'
} = Astro.props;
---

<section class="feature-grid-section">
  <div class="container">
    {(title || subtitle) && (
      <div class="section-header">
        {title && <h2>{title}</h2>}
        {subtitle && <p class="section-subtitle">{subtitle}</p>}
      </div>
    )}

    <div class={`feature-grid grid-${columns} variant-${variant}`}>
      {features.map(feature => (
        <div class="feature-card">
          {variant === 'image' && feature.image && (
            <div class="feature-image">
              <img src={feature.image} alt={feature.imageAlt || feature.title} loading="lazy" />
            </div>
          )}

          {variant === 'icon' && feature.icon && (
            <div class="feature-icon" set:html={feature.icon} />
          )}

          <h3 class="feature-title">{feature.title}</h3>
          <p class="feature-description">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .feature-grid-section {
    padding: var(--spacing-xxl) 0;
  }

  .section-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto var(--spacing-xl);
  }

  .section-header h2 {
    margin-bottom: var(--spacing-md);
  }

  .section-subtitle {
    font-size: 1.125rem;
    color: var(--color-gray-dark);
    line-height: 1.6;
  }

  .feature-grid {
    display: grid;
    gap: var(--spacing-lg);
  }

  .grid-2 {
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  }

  .grid-3 {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .grid-4 {
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  }

  .feature-card {
    background-color: var(--color-white);
    border-radius: var(--border-radius-lg);
    padding: var(--spacing-lg);
    box-shadow: var(--box-shadow);
    transition: var(--transition);
    display: flex;
    flex-direction: column;
    text-align: center;
  }

  .feature-card:hover {
    box-shadow: var(--box-shadow-lg);
    transform: translateY(-4px);
  }

  .feature-image {
    width: 100%;
    height: 200px;
    margin-bottom: var(--spacing-md);
    border-radius: var(--border-radius);
    overflow: hidden;
  }

  .feature-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .feature-icon {
    font-size: 3rem;
    margin-bottom: var(--spacing-md);
    color: var(--color-primary);
  }

  .variant-minimal .feature-card {
    box-shadow: none;
    border: 2px solid var(--color-gray-light);
    padding: var(--spacing-md);
  }

  .variant-minimal .feature-card:hover {
    border-color: var(--color-primary);
    box-shadow: none;
    transform: none;
  }

  .feature-title {
    font-size: 1.25rem;
    margin-bottom: var(--spacing-sm);
    color: var(--color-dark);
  }

  .feature-description {
    color: var(--color-gray-dark);
    line-height: 1.6;
    flex-grow: 1;
  }

  @media (max-width: 768px) {
    .feature-grid {
      grid-template-columns: 1fr;
    }

    .feature-image {
      height: 180px;
    }
  }
</style>
