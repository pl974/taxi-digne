---
/**
 * Composant BookingForm - Formulaire de réservation optimisé conversion
 * Design épuré, champs essentiels uniquement, CTA visible
 */

interface Props {
  title?: string;
  compact?: boolean;
}

const { title = "Réservez votre taxi", compact = false } = Astro.props;
---

<div class={`booking-form-container ${compact ? 'compact' : ''}`}>
  {!compact && <h2 class="form-title">{title}</h2>}

  <form class="booking-form" id="bookingForm" action="/merci" method="POST">
    <div class="form-row">
      <div class="form-group">
        <label for="pickup">Lieu de départ</label>
        <input
          type="text"
          id="pickup"
          name="pickup"
          placeholder="Ex: Digne-les-Bains"
          required
          aria-required="true"
        />
      </div>

      <div class="form-group">
        <label for="destination">Destination</label>
        <input
          type="text"
          id="destination"
          name="destination"
          placeholder="Ex: Aéroport Marseille"
          required
          aria-required="true"
        />
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="date">Date de départ</label>
        <input
          type="date"
          id="date"
          name="date"
          required
          aria-required="true"
        />
      </div>

      <div class="form-group">
        <label for="time">Heure</label>
        <input
          type="time"
          id="time"
          name="time"
          required
          aria-required="true"
        />
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="phone">Téléphone</label>
        <input
          type="tel"
          id="phone"
          name="phone"
          placeholder="06 12 34 56 78"
          required
          aria-required="true"
          pattern="[0-9\s\.\-\+]{10,}"
        />
      </div>

      <div class="form-group">
        <label for="passengers">Nombre de passagers</label>
        <select id="passengers" name="passengers" required aria-required="true">
          <option value="1">1 passager</option>
          <option value="2">2 passagers</option>
          <option value="3">3 passagers</option>
          <option value="4">4 passagers</option>
          <option value="5+">5+ passagers</option>
        </select>
      </div>
    </div>

    <div class="form-group">
      <label for="message">Informations complémentaires (optionnel)</label>
      <textarea
        id="message"
        name="message"
        rows="3"
        placeholder="Bagages, besoins spécifiques..."
      ></textarea>
    </div>

    <button type="submit" class="btn btn-primary btn-large btn-block">
      Obtenir un devis gratuit
    </button>

    <p class="form-info">
      Réponse sous 15 minutes - Sans engagement - Disponible 24h/24
    </p>
  </form>
</div>

<style>
  .booking-form-container {
    background-color: var(--color-white);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--box-shadow-lg);
    padding: var(--spacing-xl);
  }

  .booking-form-container.compact {
    padding: var(--spacing-lg);
  }

  .form-title {
    text-align: center;
    margin-bottom: var(--spacing-lg);
    color: var(--color-dark);
  }

  .booking-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .form-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--spacing-md);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-info {
    text-align: center;
    font-size: 0.875rem;
    color: var(--color-gray);
    margin-top: var(--spacing-sm);
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .booking-form-container {
      padding: var(--spacing-lg);
    }

    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Définir la date minimum à aujourd'hui
  const dateInput = document.getElementById('date') as HTMLInputElement;
  if (dateInput) {
    const today = new Date().toISOString().split('T')[0];
    dateInput.min = today;
    dateInput.value = today;
  }

  // Validation du formulaire
  const form = document.getElementById('bookingForm') as HTMLFormElement;
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      // Récupérer les données du formulaire
      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      // Ici vous pouvez ajouter l'envoi vers votre backend
      console.log('Données de réservation:', data);

      // Pour l'instant, on simule un envoi réussi
      alert('Merci pour votre demande ! Nous vous recontactons dans les plus brefs délais.');
      form.reset();
    });
  }
</script>
