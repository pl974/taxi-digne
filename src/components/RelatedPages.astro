---
/**
 * Composant RelatedPages - Pages connexes pour maillage interne
 *
 * Composant réutilisable pour afficher des liens vers pages connexes
 * Améliore le maillage interne et encourage la navigation sur le site
 *
 * @param title - Titre de la section (default: 'Pages connexes')
 * @param pages - Array de {title: string, url: string, description: string, image?: string}
 * @param variant - Style d'affichage: 'cards' | 'list' (default: 'cards')
 * @param columns - Nombre de colonnes (2, 3 ou 4) pour variant 'cards' (default: 3)
 *
 * Usage:
 * <RelatedPages pages={[
 *   {title: 'Nos services', url: '/services', description: 'Découvrez tous nos services...'},
 *   {title: 'Nos tarifs', url: '/tarifs', description: 'Tarifs transparents...'}
 * ]} />
 */

interface RelatedPage {
  title: string;
  url: string;
  description: string;
  image?: string;
}

interface Props {
  title?: string;
  pages: RelatedPage[];
  variant?: 'cards' | 'list';
  columns?: 2 | 3 | 4;
}

const {
  title = 'Pages connexes',
  pages,
  variant = 'cards',
  columns = 3
} = Astro.props;
---

<section class="related-pages">
  <div class="container">
    <h2 class="related-title">{title}</h2>

    <div class={`related-container related-${variant} columns-${columns}`}>
      {pages.map(page => (
        <article class="related-item">
          {page.image && variant === 'cards' && (
            <div class="related-image">
              <img src={page.image} alt={page.title} loading="lazy" />
            </div>
          )}
          <div class="related-content">
            <h3 class="related-item-title">
              <a href={page.url}>{page.title}</a>
            </h3>
            <p class="related-description">{page.description}</p>
            <a href={page.url} class="related-link">
              En savoir plus →
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .related-pages {
    padding: var(--spacing-xxl) 0;
    background-color: var(--color-light);
  }

  .related-title {
    text-align: center;
    margin-bottom: var(--spacing-xl);
    color: var(--color-dark);
  }

  /* Variant Cards */
  .related-cards {
    display: grid;
    gap: var(--spacing-lg);
  }

  .related-cards.columns-2 {
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
  }

  .related-cards.columns-3 {
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  }

  .related-cards.columns-4 {
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  }

  .related-cards .related-item {
    background-color: var(--color-white);
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    box-shadow: var(--box-shadow);
    transition: var(--transition);
    display: flex;
    flex-direction: column;
  }

  .related-cards .related-item:hover {
    box-shadow: var(--box-shadow-lg);
    transform: translateY(-4px);
  }

  .related-image {
    width: 100%;
    height: 180px;
    overflow: hidden;
  }

  .related-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .related-cards .related-item:hover .related-image img {
    transform: scale(1.05);
  }

  .related-content {
    padding: var(--spacing-lg);
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .related-item-title {
    font-size: 1.25rem;
    margin-bottom: var(--spacing-sm);
  }

  .related-item-title a {
    color: var(--color-dark);
    text-decoration: none;
    transition: var(--transition);
  }

  .related-item-title a:hover {
    color: var(--color-primary);
  }

  .related-description {
    color: var(--color-gray-dark);
    line-height: 1.6;
    margin-bottom: var(--spacing-md);
    flex-grow: 1;
  }

  .related-link {
    color: var(--color-primary);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: var(--transition);
  }

  .related-link:hover {
    color: var(--color-primary-dark);
    transform: translateX(4px);
  }

  /* Variant List */
  .related-list {
    max-width: 800px;
    margin: 0 auto;
  }

  .related-list .related-item {
    background-color: var(--color-white);
    padding: var(--spacing-lg);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--box-shadow);
    margin-bottom: var(--spacing-md);
    border-left: 4px solid var(--color-primary);
    transition: var(--transition);
  }

  .related-list .related-item:hover {
    box-shadow: var(--box-shadow-lg);
    transform: translateX(8px);
  }

  .related-list .related-item:last-child {
    margin-bottom: 0;
  }

  .related-list .related-item-title {
    font-size: 1.125rem;
  }

  .related-list .related-description {
    margin-bottom: var(--spacing-sm);
  }

  @media (max-width: 968px) {
    .related-cards {
      grid-template-columns: 1fr;
    }

    .related-pages {
      padding: var(--spacing-xl) 0;
    }
  }
</style>
