---
/**
 * Composant ServiceCard - Carte de présentation de service
 * Réutilisable pour afficher les différents services de taxi
 */

interface Props {
  title: string;
  description: string;
  icon?: string;
  link?: string;
  price?: string;
}

const { title, description, icon = '🚕', link, price } = Astro.props;
---

<article class="service-card">
  {icon && <div class="service-icon" aria-hidden="true">{icon}</div>}

  <h3 class="service-title">{title}</h3>

  <p class="service-description">{description}</p>

  {price && (
    <p class="service-price">
      <strong>À partir de {price}</strong>
    </p>
  )}

  {link && (
    <a href={link} class="service-link">
      En savoir plus →
    </a>
  )}
</article>

<style>
  .service-card {
    background-color: var(--color-white);
    border-radius: var(--border-radius-lg);
    padding: var(--spacing-lg);
    box-shadow: var(--box-shadow);
    transition: var(--transition);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    height: 100%;
    border: 2px solid transparent;
  }

  .service-card:hover {
    box-shadow: var(--box-shadow-lg);
    transform: translateY(-4px);
    border-color: var(--color-primary-light);
  }

  .service-icon {
    font-size: 3rem;
    margin-bottom: var(--spacing-sm);
    text-align: center;
  }

  .service-title {
    font-size: 1.375rem;
    color: var(--color-dark);
    margin-bottom: var(--spacing-xs);
    text-align: center;
  }

  .service-description {
    color: var(--color-gray-dark);
    line-height: 1.6;
    flex-grow: 1;
    text-align: center;
  }

  .service-price {
    color: var(--color-primary);
    font-size: 1.125rem;
    text-align: center;
    margin-top: var(--spacing-sm);
  }

  .service-link {
    color: var(--color-primary);
    font-weight: var(--font-weight-semibold);
    text-align: center;
    display: inline-block;
    margin-top: var(--spacing-xs);
    transition: var(--transition);
  }

  .service-link:hover {
    color: var(--color-primary-dark);
    transform: translateX(4px);
  }
</style>
