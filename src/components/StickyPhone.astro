---
/**
 * Composant StickyPhone - Bouton téléphone sticky pour mobile
 * Visible en permanence en bas de l'écran sur mobile
 */

interface Props {
  phoneNumber: string;
  displayNumber: string;
}

const {
  phoneNumber = "+33123456789",
  displayNumber = "01 23 45 67 89"
} = Astro.props;
---

<a href={`tel:${phoneNumber}`} class="sticky-phone" aria-label="Appeler maintenant">
  <svg class="phone-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
  </svg>
  <span class="phone-text">{displayNumber}</span>
</a>

<style>
  .sticky-phone {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 1000;
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-md) var(--spacing-lg);
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
    color: var(--color-white);
    text-decoration: none;
    border-radius: 50px;
    box-shadow: 0 4px 20px rgba(0, 102, 204, 0.4);
    transition: all 0.3s ease;
    animation: pulse 2s infinite;
  }

  .sticky-phone:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 30px rgba(0, 102, 204, 0.5);
    color: var(--color-white);
  }

  .phone-icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  .phone-text {
    font-weight: var(--font-weight-semibold);
    font-size: 1.125rem;
    white-space: nowrap;
  }

  @keyframes pulse {
    0%, 100% {
      box-shadow: 0 4px 20px rgba(0, 102, 204, 0.4);
    }
    50% {
      box-shadow: 0 4px 30px rgba(0, 102, 204, 0.6);
    }
  }

  /* Masquer sur desktop, afficher seulement sur tablette et mobile */
  @media (min-width: 1024px) {
    .sticky-phone {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .sticky-phone {
      bottom: 15px;
      right: 15px;
      padding: var(--spacing-sm) var(--spacing-md);
    }

    .phone-text {
      font-size: 1rem;
    }

    .phone-icon {
      width: 20px;
      height: 20px;
    }
  }
</style>
