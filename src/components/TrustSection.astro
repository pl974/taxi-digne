---
/**
 * TrustSection - Section de confiance avec images
 * Affiche des éléments de réassurance (certifications, satisfaction, zone) avec images
 */

interface TrustItem {
  src: string;
  alt: string;
  caption: string;
  description?: string;
}

interface Props {
  title: string;
  subtitle?: string;
  items: TrustItem[];
  variant?: 'grid' | 'slider' | 'split';
  bgColor?: 'light' | 'white' | 'primary';
}

const {
  title,
  subtitle,
  items,
  variant = 'grid',
  bgColor = 'light'
} = Astro.props;
---

<section class={`trust-section trust-section--${variant} trust-section--bg-${bgColor}`}>
  <div class="container">
    <div class="trust-header">
      <h2>{title}</h2>
      {subtitle && <p class="trust-subtitle">{subtitle}</p>}
    </div>

    <div class={`trust-items trust-items--${variant}`}>
      {items.map(item => (
        <div class="trust-item">
          <div class="trust-item-image">
            <img src={item.src} alt={item.alt} loading="lazy" />
          </div>
          <div class="trust-item-content">
            <h3>{item.caption}</h3>
            {item.description && <p>{item.description}</p>}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .trust-section {
    padding: var(--spacing-xxl) 0;
  }

  .trust-section--bg-light {
    background-color: var(--color-light);
  }

  .trust-section--bg-white {
    background-color: var(--color-white);
  }

  .trust-section--bg-primary {
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
  }

  .trust-section--bg-primary .trust-header h2,
  .trust-section--bg-primary .trust-header p,
  .trust-section--bg-primary .trust-item-content h3,
  .trust-section--bg-primary .trust-item-content p {
    color: var(--color-white);
  }

  .trust-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto var(--spacing-xl);
  }

  .trust-header h2 {
    margin-bottom: var(--spacing-md);
  }

  .trust-subtitle {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-gray-dark);
  }

  .trust-items--grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--spacing-lg);
  }

  .trust-items--slider {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--spacing-xl);
  }

  .trust-items--split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: var(--spacing-xl);
  }

  .trust-item {
    background-color: var(--color-white);
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    box-shadow: var(--box-shadow);
    transition: var(--transition);
    display: flex;
    flex-direction: column;
  }

  .trust-section--bg-white .trust-item {
    border: 2px solid var(--color-gray-light);
  }

  .trust-item:hover {
    box-shadow: var(--box-shadow-lg);
    transform: translateY(-4px);
  }

  .trust-item-image {
    width: 100%;
    height: 200px;
    overflow: hidden;
  }

  .trust-items--split .trust-item {
    flex-direction: row;
    align-items: center;
  }

  .trust-items--split .trust-item-image {
    width: 40%;
    height: 250px;
    flex-shrink: 0;
  }

  .trust-item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .trust-item:hover .trust-item-image img {
    transform: scale(1.05);
  }

  .trust-item-content {
    padding: var(--spacing-lg);
    flex-grow: 1;
  }

  .trust-item-content h3 {
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
    font-size: 1.25rem;
  }

  .trust-item-content p {
    line-height: 1.6;
    color: var(--color-gray-dark);
    margin: 0;
  }

  @media (max-width: 968px) {
    .trust-items--grid,
    .trust-items--slider,
    .trust-items--split {
      grid-template-columns: 1fr;
    }

    .trust-items--split .trust-item {
      flex-direction: column;
    }

    .trust-items--split .trust-item-image {
      width: 100%;
      height: 200px;
    }
  }
</style>
