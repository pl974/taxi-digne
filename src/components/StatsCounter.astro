---
/**
 * Composant StatsCounter - Compteurs de statistiques/chiffres clés
 * Affiche les chiffres importants de manière visuelle
 */

interface Stat {
  number: string;
  label: string;
  suffix?: string;
  icon?: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  stats: Stat[];
  variant?: 'light' | 'dark' | 'primary';
}

const {
  title,
  subtitle,
  stats,
  variant = 'light'
} = Astro.props;
---

<section class={`stats-counter variant-${variant}`}>
  <div class="container">
    {(title || subtitle) && (
      <div class="section-header">
        {title && <h2>{title}</h2>}
        {subtitle && <p class="section-subtitle">{subtitle}</p>}
      </div>
    )}

    <div class="stats-grid">
      {stats.map(stat => (
        <div class="stat-item">
          {stat.icon && (
            <div class="stat-icon" set:html={stat.icon} />
          )}
          <div class="stat-number">
            <span class="number">{stat.number}</span>
            {stat.suffix && <span class="suffix">{stat.suffix}</span>}
          </div>
          <div class="stat-label">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stats-counter {
    padding: var(--spacing-xxl) 0;
  }

  .variant-light {
    background-color: var(--color-light);
  }

  .variant-dark {
    background-color: var(--color-dark);
    color: var(--color-white);
  }

  .variant-primary {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: var(--color-white);
  }

  .section-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto var(--spacing-xl);
  }

  .section-header h2 {
    margin-bottom: var(--spacing-md);
  }

  .variant-dark .section-header h2,
  .variant-primary .section-header h2 {
    color: var(--color-white);
  }

  .section-subtitle {
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .variant-light .section-subtitle {
    color: var(--color-gray-dark);
  }

  .variant-dark .section-subtitle,
  .variant-primary .section-subtitle {
    color: rgba(255, 255, 255, 0.9);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--spacing-xl);
  }

  .stat-item {
    text-align: center;
    padding: var(--spacing-lg);
  }

  .stat-icon {
    font-size: 2.5rem;
    margin-bottom: var(--spacing-sm);
  }

  .variant-light .stat-icon {
    color: var(--color-primary);
  }

  .variant-dark .stat-icon,
  .variant-primary .stat-icon {
    color: var(--color-secondary);
  }

  .stat-number {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: var(--font-weight-bold);
    line-height: 1;
    margin-bottom: var(--spacing-sm);
  }

  .variant-light .stat-number {
    color: var(--color-primary);
  }

  .variant-dark .stat-number,
  .variant-primary .stat-number {
    color: var(--color-white);
  }

  .number {
    display: inline-block;
  }

  .suffix {
    font-size: 0.6em;
    margin-left: 0.25rem;
  }

  .stat-label {
    font-size: 1.125rem;
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .variant-light .stat-label {
    color: var(--color-gray-dark);
  }

  .variant-dark .stat-label,
  .variant-primary .stat-label {
    color: rgba(255, 255, 255, 0.9);
  }

  @media (max-width: 768px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-lg);
    }

    .stat-number {
      font-size: clamp(2rem, 8vw, 3rem);
    }
  }

  @media (max-width: 480px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
