---
/**
 * Page Services - Détail de tous les services de taxi
 * Optimisée SEO avec ancres, images et maillage interne
 * Version améliorée avec composants visuels
 */

import Layout from '../layouts/Layout.astro';
import ImageHero from '../components/ImageHero.astro';
import ServiceDetailCard from '../components/ServiceDetailCard.astro';
import TrustSection from '../components/TrustSection.astro';
import BookingForm from '../components/BookingForm.astro';
import CTA from '../components/CTA.astro';

const title = "Nos services de taxi";
const description = "Découvrez tous nos services de taxi : transfert aéroport, gare, transport médical, courses locales, longue distance. Service 24h/24 dans les Alpes-de-Haute-Provence.";
---

<Layout title={title} description={description}>
  <!-- Hero avec image -->
  <ImageHero
    title="Nos services de taxi à Digne et dans les Alpes-de-Haute-Provence"
    subtitle="Un service complet pour tous vos besoins de transport, disponible 24h/24 et 7j/7"
    image="/images/hero/hero-transfert-aeroport.webp"
    imageAlt="Services de taxi professionnels à Digne-les-Bains"
    ctaPrimary={{ text: "Appeler maintenant", href: "tel:+33123456789" }}
    ctaSecondary={{ text: "Voir les tarifs", href: "/tarifs" }}
    variant="full"
    height="medium"
    overlay="dark"
  />

  <!-- Navigation rapide -->
  <nav class="services-nav">
    <div class="container">
      <ul class="services-menu">
        <li><a href="#transfert-aeroport">Transfert aéroport</a></li>
        <li><a href="#transfert-gare">Transfert gare</a></li>
        <li><a href="#taxi-longue-distance">Longue distance</a></li>
        <li><a href="#taxi-medical">Transport médical</a></li>
        <li><a href="#courses-locales">Courses locales</a></li>
        <li><a href="#taxi-professionnel">Taxi professionnel</a></li>
      </ul>
    </div>
  </nav>

  <!-- Services détaillés avec images -->
  <section class="services-content">
    <div class="container">
      <div class="services-layout">
        <div class="services-main">

          <!-- Service 1: Transfert aéroport -->
          <div id="transfert-aeroport">
            <ServiceDetailCard
              title="Transfert aéroport depuis Digne-les-Bains"
              description="Notre service de transfert aéroport vous emmène vers tous les aéroports de la région PACA en toute sérénité. Service porte-à-porte avec suivi de vol et assistance bagages inclus."
              image="/images/services/service-transfert-aeroport.webp"
              imageAlt="Transfert aéroport taxi Digne Marseille Nice Toulon"
              price="À partir de 90€"
              variant="left"
              features={[
                "Suivi de vol en temps réel - Adaptation en cas de retard",
                "Assistance bagages du domicile au terminal",
                "Véhicules spacieux avec grande capacité de coffre",
                "Réservation anticipée pour garantir votre place"
              ]}
            />
            <div class="service-destinations">
              <h3>Aéroports desservis</h3>
              <ul>
                <li><strong>Aéroport Marseille-Provence (MRS)</strong> - 1h30 - à partir de 120€</li>
                <li><strong>Aéroport Nice Côte d'Azur (NCE)</strong> - 2h - à partir de 150€</li>
                <li><strong>Aéroport Toulon-Hyères (TLN)</strong> - 2h - à partir de 140€</li>
              </ul>
            </div>
          </div>

          <!-- Service 2: Transfert gare -->
          <div id="transfert-gare">
            <ServiceDetailCard
              title="Transfert gare SNCF"
              description="Service de navette gare pour tous vos trajets vers et depuis les gares SNCF des Alpes-de-Haute-Provence. Ponctualité garantie pour vos correspondances ferroviaires."
              image="/images/services/service-transfert-gare.webp"
              imageAlt="Transfert gare SNCF taxi Digne Manosque Sisteron"
              price="À partir de 20€"
              variant="right"
              features={[
                "Dépose directe devant l'entrée de la gare",
                "Assistance avec les bagages",
                "Réservation avec horaire de train",
                "Service retour après arrivée"
              ]}
            />
            <div class="service-destinations">
              <h3>Gares principales desservies</h3>
              <ul>
                <li><strong>Gare de Digne-les-Bains</strong> - Boulevard Gassendi</li>
                <li><strong>Gare de Manosque</strong> - Centre-ville</li>
                <li><strong>Gare de Sisteron</strong> - Liaison TGV</li>
                <li><strong>Gare d'Aix-en-Provence TGV</strong> - 1h15 depuis Digne</li>
              </ul>
            </div>
          </div>

          <!-- Service 3: Longue distance -->
          <div id="taxi-longue-distance">
            <ServiceDetailCard
              title="Taxi longue distance"
              description="Nos taxis longue distance vous emmènent partout en France et même au-delà. Confort optimal pour vos déplacements professionnels ou personnels sur de longues distances."
              image="/images/services/service-taxi-longue-distance.webp"
              imageAlt="Taxi longue distance Digne Marseille Nice Gap Avignon"
              price="Sur devis"
              variant="left"
              features={[
                "Confort maximal pour les longs trajets",
                "Véhicules récents et climatisés",
                "Chauffeurs expérimentés longue distance",
                "Tarifs dégressifs selon la distance"
              ]}
            />
            <div class="service-destinations destinations-grid">
              <div><strong>Marseille</strong><span>1h45 - 130€</span></div>
              <div><strong>Nice</strong><span>2h15 - 160€</span></div>
              <div><strong>Aix-en-Provence</strong><span>1h30 - 110€</span></div>
              <div><strong>Gap</strong><span>1h30 - 100€</span></div>
              <div><strong>Avignon</strong><span>2h - 140€</span></div>
              <div><strong>Toulon</strong><span>2h - 150€</span></div>
            </div>
          </div>

          <!-- Service 4: Transport médical -->
          <div id="taxi-medical">
            <ServiceDetailCard
              title="Transport médical conventionné"
              description="Notre service de transport médical conventionné assure vos déplacements pour raisons de santé. Remboursement par la Sécurité Sociale selon prescription médicale."
              image="/images/services/service-transport-medical.webp"
              imageAlt="Transport médical conventionné CPAM taxi Digne hôpital"
              price="Remboursé CPAM"
              variant="right"
              features={[
                "Conventionné CPAM - Remboursement assuré",
                "Gestion des formalités administratives",
                "Chauffeurs formés au transport médical",
                "Ponctualité garantie pour vos rendez-vous"
              ]}
            />
            <div class="service-destinations">
              <h3>Types de transport médical</h3>
              <ul>
                <li>Rendez-vous médicaux et consultations spécialistes</li>
                <li>Hospitalisations et retours à domicile</li>
                <li>Dialyse et chimiothérapie (trajets réguliers)</li>
                <li>Examens médicaux (IRM, scanner, radiologie)</li>
              </ul>
              <h3>Établissements desservis</h3>
              <ul>
                <li>Centre Hospitalier de Digne-les-Bains</li>
                <li>Centre Hospitalier de Manosque</li>
                <li>CHU de Marseille, Nice et Gap</li>
              </ul>
            </div>
          </div>

          <!-- Service 5: Courses locales -->
          <div id="courses-locales">
            <ServiceDetailCard
              title="Courses locales et déplacements quotidiens"
              description="Pour tous vos déplacements quotidiens à Digne-les-Bains et dans les Alpes-de-Haute-Provence. Service rapide et efficace pour vos courses du quotidien."
              image="/images/services/service-courses-locales.webp"
              imageAlt="Courses locales taxi Digne déplacements quotidiens"
              price="À partir de 15€"
              variant="left"
              features={[
                "Déplacements en centre-ville rapides",
                "Courses vers commerces et supermarchés",
                "Rendez-vous professionnels et personnels",
                "Service dans tous les quartiers de Digne"
              ]}
            />
            <div class="service-destinations">
              <p class="service-note">
                Nous intervenons dans toute l'agglomération de
                <a href="/villes/digne-les-bains">Digne-les-Bains</a> et ses communes :
                Aiglun, Marcoux, Champtercier, Mallemoisson, Thoard et toute la vallée de la Bléone.
              </p>
            </div>
          </div>

          <!-- Service 6: Taxi professionnel -->
          <div id="taxi-professionnel">
            <ServiceDetailCard
              title="Service taxi pour les professionnels et entreprises"
              description="Solution de transport professionnel dédiée aux entreprises des Alpes-de-Haute-Provence. Disponibilité garantie et facturation simplifiée pour vos déplacements d'affaires."
              image="/images/services/service-taxi-professionnel.webp"
              imageAlt="Taxi professionnel entreprises Digne transport affaires"
              price="Tarifs dégressifs"
              variant="right"
              features={[
                "Facturation mensuelle groupée",
                "Compte entreprise dédié",
                "Disponibilité prioritaire",
                "Suivi des courses en ligne"
              ]}
            />
            <div class="service-destinations">
              <h3>Services pour entreprises</h3>
              <ul>
                <li>Transport de collaborateurs et visiteurs</li>
                <li>Transferts aéroport pour vos clients</li>
                <li>Événements d'entreprise et séminaires</li>
                <li>Mise à disposition de véhicule à la journée</li>
              </ul>
            </div>
          </div>

        </div>

        <!-- Sidebar -->
        <aside class="services-sidebar">
          <div class="sidebar-booking">
            <h3>Réserver un service</h3>
            <BookingForm compact={true} />
          </div>

          <div class="sidebar-contact">
            <h3>Besoin d'informations ?</h3>
            <p>Appelez-nous pour toute question</p>
            <a href="tel:+33123456789" class="sidebar-phone">01 23 45 67 89</a>
            <p class="sidebar-info">Disponible 24h/24</p>
          </div>

          <div class="sidebar-cities">
            <h3>Nos secteurs</h3>
            <ul>
              <li><a href="/villes/digne-les-bains">Digne-les-Bains</a></li>
              <li><a href="/villes/manosque">Manosque</a></li>
              <li><a href="/villes/sisteron">Sisteron</a></li>
              <li><a href="/villes/forcalquier">Forcalquier</a></li>
              <li><a href="/villes">Toutes les villes</a></li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Section confiance avec certifications et satisfaction -->
  <TrustSection
    title="Pourquoi nous faire confiance ?"
    subtitle="Plus de 15 ans d'expérience et des centaines de clients satisfaits"
    items={[
      {
        src: "/images/about/certifications-licences.webp",
        alt: "Certifications professionnelles taxi Digne-les-Bains",
        caption: "Certifications professionnelles",
        description: "Tous nos chauffeurs sont titulaires de la carte professionnelle de taxi et parfaitement formés aux normes de sécurité."
      },
      {
        src: "/images/about/satisfaction-client.webp",
        alt: "Clients satisfaits service taxi Digne avis 5 étoiles",
        caption: "Satisfaction client garantie",
        description: "Des centaines de clients nous font confiance chaque mois. Note moyenne de 4.8/5 basée sur plus de 500 avis vérifiés."
      },
      {
        src: "/images/about/zone-intervention-alpes.webp",
        alt: "Couverture complète Alpes-de-Haute-Provence taxi Digne",
        caption: "Couverture complète du 04",
        description: "Service disponible dans tout le département des Alpes-de-Haute-Provence et départements limitrophes."
      }
    ]}
    variant="grid"
    bgColor="light"
  />

  <!-- CTA -->
  <CTA
    title="Prêt à réserver votre course ?"
    subtitle="Contactez-nous maintenant pour réserver votre taxi ou obtenir un devis personnalisé"
    buttonText="Réserver maintenant"
    phoneNumber="01 23 45 67 89"
  />
</Layout>

<style>
  .services-nav {
    background-color: var(--color-white);
    padding: var(--spacing-md) 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    position: sticky;
    top: 70px;
    z-index: 100;
  }

  .services-menu {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--spacing-md);
  }

  .services-menu a {
    color: var(--color-dark);
    font-weight: var(--font-weight-medium);
    padding: 0.5rem 1rem;
    border-radius: var(--border-radius);
    transition: var(--transition);
    text-decoration: none;
  }

  .services-menu a:hover {
    background-color: var(--color-primary);
    color: var(--color-white);
  }

  .services-content {
    padding: var(--spacing-xxl) 0;
  }

  .services-layout {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--spacing-xl);
  }

  .services-main > div {
    margin-bottom: var(--spacing-xxl);
    padding-bottom: var(--spacing-xl);
    border-bottom: 2px solid var(--color-gray-light);
  }

  .services-main > div:last-child {
    border-bottom: none;
  }

  .service-destinations {
    margin-top: var(--spacing-lg);
    padding: var(--spacing-lg);
    background-color: var(--color-light);
    border-radius: var(--border-radius-lg);
  }

  .service-destinations h3 {
    color: var(--color-primary);
    margin-bottom: var(--spacing-md);
  }

  .service-destinations ul {
    list-style: none;
    padding: 0;
  }

  .service-destinations li {
    padding: 0.5rem 0;
    padding-left: 1.5rem;
    position: relative;
    line-height: 1.6;
  }

  .service-destinations li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-success);
    font-weight: bold;
  }

  .destinations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--spacing-md);
    padding: var(--spacing-lg);
  }

  .destinations-grid > div {
    background-color: var(--color-white);
    padding: var(--spacing-md);
    border-radius: var(--border-radius);
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .destinations-grid strong {
    color: var(--color-dark);
    font-size: 1.0625rem;
  }

  .destinations-grid span {
    color: var(--color-primary);
    font-weight: var(--font-weight-semibold);
  }

  .service-note {
    padding: var(--spacing-md);
    background-color: var(--color-white);
    border-radius: var(--border-radius);
    margin-top: var(--spacing-md);
    line-height: 1.7;
  }

  .service-note a {
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
  }

  .services-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
    position: sticky;
    top: 140px;
  }

  .sidebar-booking,
  .sidebar-contact,
  .sidebar-cities {
    background-color: var(--color-white);
    padding: var(--spacing-lg);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--box-shadow);
  }

  .sidebar-contact {
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
    color: var(--color-white);
    text-align: center;
  }

  .sidebar-contact h3 {
    color: var(--color-white);
    margin-bottom: var(--spacing-sm);
  }

  .sidebar-contact p {
    color: var(--color-white);
    margin-bottom: var(--spacing-sm);
  }

  .sidebar-phone {
    display: block;
    font-size: 1.75rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-secondary);
    text-decoration: none;
    margin: var(--spacing-md) 0;
  }

  .sidebar-info {
    font-size: 0.9375rem;
    opacity: 0.9;
  }

  .sidebar-cities h3 {
    margin-bottom: var(--spacing-md);
  }

  .sidebar-cities ul {
    list-style: none;
    padding: 0;
  }

  .sidebar-cities li {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-gray-light);
  }

  .sidebar-cities li:last-child {
    border-bottom: none;
  }

  .sidebar-cities a {
    color: var(--color-primary);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
  }

  .sidebar-cities a:hover {
    color: var(--color-primary-dark);
  }

  @media (max-width: 968px) {
    .services-layout {
      grid-template-columns: 1fr;
    }

    .services-sidebar {
      order: -1;
      position: static;
    }

    .services-menu {
      flex-direction: column;
      align-items: stretch;
    }

    .services-menu a {
      text-align: center;
    }

    .destinations-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
