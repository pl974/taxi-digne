---
/**
 * Page de remerciement après soumission du formulaire
 * Affichée après validation Netlify Forms
 */

import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';

const title = "Merci pour votre demande";
const description = "Votre demande de devis a bien été reçue. Nous vous recontactons sous 15 minutes.";
---

<Layout title={title} description={description} noindex={true}>
  <section class="thank-you-page">
    <div class="container">
      <div class="thank-you-content">
        <div class="success-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10" fill="#10b981" opacity="0.1"/>
            <path d="M9 12l2 2 4-4" stroke="#10b981" stroke-width="3"/>
          </svg>
        </div>

        <h1>Merci pour votre demande de réservation !</h1>

        <div class="message-box">
          <p class="lead">
            Votre demande a bien été <strong>enregistrée</strong> et transmise à notre équipe.
          </p>

          <div class="next-steps">
            <h2>Prochaines étapes</h2>
            <ol class="steps-list">
              <li>
                <strong>Nous étudions votre demande</strong><br>
                Notre équipe analyse votre trajet et prépare votre devis personnalisé
              </li>
              <li>
                <strong>Vous recevez notre réponse sous 15 minutes</strong><br>
                Nous vous contactons par téléphone ou email avec le tarif exact et la confirmation de disponibilité
              </li>
              <li>
                <strong>Vous confirmez votre réservation</strong><br>
                Une fois d'accord, nous confirmons votre course et vous envoyons un SMS de rappel
              </li>
            </ol>
          </div>

          <div class="info-box">
            <h3>Besoin urgent d'un taxi ?</h3>
            <p>
              Pour une prise en charge immédiate, appelez-nous directement au
              <a href="tel:+33123456789" class="phone-highlight">01 23 45 67 89</a>
            </p>
            <p class="availability">Disponible 24h/24 et 7j/7</p>
          </div>
        </div>

        <div class="actions">
          <a href="/" class="btn btn-primary btn-large">Retour à l'accueil</a>
          <a href="/tarifs" class="btn btn-secondary btn-large">Voir nos tarifs</a>
        </div>
      </div>
    </div>
  </section>

  <CTA
    title="Une question sur votre réservation ?"
    subtitle="Notre équipe est disponible 24h/24 pour répondre à toutes vos questions"
    buttonText="Nous contacter"
    phoneNumber="01 23 45 67 89"
  />
</Layout>

<style>
  .thank-you-page {
    padding: var(--spacing-xxl) 0;
    min-height: 60vh;
  }

  .thank-you-content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .success-icon {
    margin-bottom: var(--spacing-lg);
    animation: scaleIn 0.5s ease-out;
  }

  @keyframes scaleIn {
    from {
      transform: scale(0);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  .success-icon svg {
    color: var(--color-success);
  }

  .thank-you-content h1 {
    color: var(--color-dark);
    margin-bottom: var(--spacing-lg);
    font-size: 2.5rem;
  }

  .message-box {
    background-color: var(--color-white);
    padding: var(--spacing-xl);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--box-shadow-lg);
    margin-bottom: var(--spacing-xl);
    text-align: left;
  }

  .lead {
    font-size: 1.25rem;
    line-height: 1.6;
    margin-bottom: var(--spacing-lg);
    text-align: center;
  }

  .next-steps {
    margin: var(--spacing-xl) 0;
  }

  .next-steps h2 {
    color: var(--color-primary);
    margin-bottom: var(--spacing-md);
    font-size: 1.5rem;
  }

  .steps-list {
    list-style: none;
    counter-reset: step-counter;
    padding: 0;
  }

  .steps-list li {
    counter-increment: step-counter;
    position: relative;
    padding: var(--spacing-md) 0 var(--spacing-md) 3.5rem;
    border-left: 3px solid var(--color-light);
    margin-bottom: var(--spacing-md);
  }

  .steps-list li:last-child {
    border-left-color: transparent;
    margin-bottom: 0;
  }

  .steps-list li::before {
    content: counter(step-counter);
    position: absolute;
    left: -1.25rem;
    top: var(--spacing-md);
    width: 2.5rem;
    height: 2.5rem;
    background-color: var(--color-primary);
    color: var(--color-white);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: var(--font-weight-bold);
    font-size: 1.125rem;
  }

  .steps-list li strong {
    display: block;
    color: var(--color-dark);
    margin-bottom: 0.25rem;
    font-size: 1.125rem;
  }

  .info-box {
    background-color: var(--color-light);
    padding: var(--spacing-lg);
    border-radius: var(--border-radius);
    border-left: 4px solid var(--color-primary);
    margin-top: var(--spacing-xl);
  }

  .info-box h3 {
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
    font-size: 1.25rem;
  }

  .info-box p {
    margin-bottom: var(--spacing-sm);
  }

  .phone-highlight {
    color: var(--color-primary);
    font-weight: var(--font-weight-bold);
    font-size: 1.5rem;
    text-decoration: none;
    display: inline-block;
    margin: 0.5rem 0;
  }

  .phone-highlight:hover {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }

  .availability {
    font-size: 0.9375rem;
    color: var(--color-gray);
    margin-bottom: 0;
  }

  .actions {
    display: flex;
    gap: var(--spacing-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .thank-you-content h1 {
      font-size: 1.75rem;
    }

    .message-box {
      padding: var(--spacing-lg);
    }

    .steps-list li {
      padding-left: 2.5rem;
    }

    .steps-list li::before {
      width: 2rem;
      height: 2rem;
      left: -1rem;
      font-size: 1rem;
    }

    .actions {
      flex-direction: column;
    }

    .actions a {
      width: 100%;
    }
  }
</style>
