---
/**
 * Page Tarifs - Grille tarifaire transparente optimisée conversion
 */

import Layout from '../layouts/Layout.astro';
import ImageHero from '../components/ImageHero.astro';
import TrustSection from '../components/TrustSection.astro';
import BookingForm from '../components/BookingForm.astro';
import CTA from '../components/CTA.astro';
import FAQSection from '../components/FAQSection.astro';
import RelatedPages from '../components/RelatedPages.astro';

const title = "Nos tarifs de taxi";
const description = "Tarifs transparents pour tous nos services de taxi à Digne et dans les Alpes-de-Haute-Provence. Devis gratuit en ligne. Réservez au meilleur prix.";

// FAQ Tarifs
const tarifsFAQ = [
  {
    question: "Comment est calculé le tarif de nuit pour un taxi à Digne ?",
    answer: "<p>Le <strong>tarif de nuit</strong> s'applique de 20h à 7h du matin et entraîne une <strong>majoration de 20%</strong> sur le prix de base. Cette majoration est réglementée par la préfecture et couvre les frais supplémentaires liés au service nocturne : disponibilité réduite des chauffeurs, sécurité renforcée et charges d'exploitation plus élevées. Lors de votre réservation, nous vous indiquons systématiquement le <strong>tarif total incluant cette majoration</strong>, sans surprise à l'arrivée.</p>"
  },
  {
    question: "Y a-t-il des frais cachés dans vos tarifs de taxi ?",
    answer: "<p><strong>Absolument aucun frais caché</strong>. Nous croyons en la transparence totale. Le prix annoncé lors de la réservation est le prix final que vous payez. Les seuls suppléments possibles sont clairement indiqués à l'avance : majoration de nuit (+20%), dimanche et jours fériés (+20%), bagages volumineux (+5€/pièce) et péages autoroutiers au tarif réel. Tous ces éléments vous sont communiqués lors du <strong>devis gratuit</strong> avant la course.</p>"
  },
  {
    question: "Puis-je obtenir un devis avant de réserver ma course ?",
    answer: "<p>Bien sûr ! Nous fournissons systématiquement un <strong>devis gratuit et sans engagement</strong> pour toute demande. Vous pouvez nous contacter par téléphone au 01 23 45 67 89 ou utiliser notre formulaire de réservation en ligne. Nous vous répondons sous 15 minutes avec un tarif précis et définitif basé sur votre trajet, l'horaire et vos besoins spécifiques. Ce devis reste valable et le prix ne change pas, même si les conditions de circulation varient.</p>"
  },
  {
    question: "Comment puis-je annuler ma réservation de taxi ?",
    answer: "<p>Vous pouvez annuler votre réservation <strong>gratuitement jusqu'à 24 heures avant</strong> l'heure prévue de prise en charge. Il suffit de nous appeler au 01 23 45 67 89 ou d'envoyer un email. Pour les annulations de dernière minute (moins de 24h), des frais d'annulation de 20% du montant peuvent s'appliquer pour compenser l'immobilisation du véhicule et du chauffeur. Nous restons néanmoins flexibles en cas de circonstances exceptionnelles.</p>"
  },
  {
    question: "Quels sont les moyens de paiement acceptés dans vos taxis ?",
    answer: "<p>Nous acceptons <strong>tous les moyens de paiement courants</strong> pour votre confort : espèces, carte bancaire (Visa, Mastercard, American Express), chèques bancaires, et facturation pour les entreprises avec compte client. Pour le <strong>transport médical conventionné</strong>, nous gérons directement le tiers payant avec votre caisse d'assurance maladie. Tous nos véhicules sont équipés de terminaux de paiement électronique modernes et sécurisés.</p>"
  },
  {
    question: "Vos tarifs incluent-ils les bagages et le suivi de vol ?",
    answer: "<p>Oui, nos tarifs incluent le <strong>transport de bagages standards</strong> sans supplément (valises cabine et bagages enregistrés classiques). Pour les transferts aéroport, le <strong>suivi de vol en temps réel</strong> est également inclus : nous ajustons automatiquement l'heure de prise en charge en cas de retard ou d'avance de votre vol. Seuls les bagages particulièrement volumineux ou encombrants (matériel sportif, instruments de musique) peuvent entraîner un supplément de 5€ par pièce.</p>"
  }
];

// Pages connexes
const relatedPages = [
  {
    title: "Nos services de taxi",
    url: "/services",
    description: "Découvrez tous nos services : transferts aéroport, gare, courses locales, mise à disposition et transport médical.",
    image: "/images/services/transfert-aeroport.webp"
  },
  {
    title: "Villes desservies",
    url: "/villes",
    description: "Nous desservons Digne-les-Bains et toutes les communes des Alpes-de-Haute-Provence : Manosque, Sisteron, Forcalquier...",
    image: "/images/villes/digne-les-bains.webp"
  },
  {
    title: "Réserver un taxi",
    url: "/contact",
    description: "Contactez-nous pour réserver votre taxi ou obtenir un devis gratuit. Réponse garantie sous 15 minutes.",
    image: "/images/about/satisfaction-client.webp"
  }
];
---

<Layout title={title} description={description}>
  <!-- Hero avec image -->
  <ImageHero
    title="Nos tarifs de taxi à Digne-les-Bains"
    subtitle="Tarifs transparents et compétitifs. Pas de surprise à l'arrivée, le prix vous est communiqué avant chaque course."
    image="/images/features/tarifs-transparents.webp"
    imageAlt="Tarifs transparents pour taxi à Digne-les-Bains"
    ctaPrimary={{ text: "Demander un devis", href: "#booking" }}
    ctaSecondary={{ text: "Appeler maintenant", href: "tel:+33123456789" }}
    variant="full"
    height="medium"
    overlay="gradient"
  />

  <!-- Tarifs principaux -->
  <section class="tarifs-main">
    <div class="container">
      <div class="tarifs-intro">
        <h2>Grille tarifaire indicative</h2>
        <p>
          Nos tarifs sont calculés en fonction de la distance, de l'horaire et du type de service.
          Les prix ci-dessous sont donnés à titre indicatif. Pour un <strong>devis précis et gratuit</strong>,
          utilisez notre formulaire de réservation ou contactez-nous directement.
        </p>
      </div>

      <!-- Tarifs par trajet -->
      <div class="tarifs-section">
        <h3>Transferts aéroport depuis Digne-les-Bains</h3>
        <div class="tarifs-grid">
          <div class="tarif-card">
            <div class="tarif-destination">
              <strong>Aéroport Marseille-Provence</strong>
              <span class="tarif-distance">150 km - 1h30</span>
            </div>
            <div class="tarif-price">
              <span class="price-amount">120€</span>
              <span class="price-note">1-4 passagers</span>
            </div>
          </div>

          <div class="tarif-card">
            <div class="tarif-destination">
              <strong>Aéroport Nice Côte d'Azur</strong>
              <span class="tarif-distance">180 km - 2h</span>
            </div>
            <div class="tarif-price">
              <span class="price-amount">150€</span>
              <span class="price-note">1-4 passagers</span>
            </div>
          </div>

          <div class="tarif-card">
            <div class="tarif-destination">
              <strong>Aéroport Toulon-Hyères</strong>
              <span class="tarif-distance">170 km - 2h</span>
            </div>
            <div class="tarif-price">
              <span class="price-amount">140€</span>
              <span class="price-note">1-4 passagers</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Tarifs gares -->
      <div class="tarifs-section">
        <h3>Transferts gare depuis Digne-les-Bains</h3>
        <div class="tarifs-grid">
          <div class="tarif-card">
            <div class="tarif-destination">
              <strong>Gare de Digne (centre-ville)</strong>
              <span class="tarif-distance">Selon quartier</span>
            </div>
            <div class="tarif-price">
              <span class="price-amount">15-25€</span>
              <span class="price-note">Trajet local</span>
            </div>
          </div>

          <div class="tarif-card">
            <div class="tarif-destination">
              <strong>Gare de Manosque</strong>
              <span class="tarif-distance">60 km - 45 min</span>
            </div>
            <div class="tarif-price">
              <span class="price-amount">60€</span>
              <span class="price-note">1-4 passagers</span>
            </div>
          </div>

          <div class="tarif-card">
            <div class="tarif-destination">
              <strong>Gare Aix-en-Provence TGV</strong>
              <span class="tarif-distance">100 km - 1h15</span>
            </div>
            <div class="tarif-price">
              <span class="price-amount">100€</span>
              <span class="price-note">1-4 passagers</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Tarifs villes -->
      <div class="tarifs-section">
        <h3>Liaisons entre villes</h3>
        <div class="tarifs-grid">
          <div class="tarif-card">
            <div class="tarif-destination">
              <strong>Digne → Manosque</strong>
              <span class="tarif-distance">60 km - 45 min</span>
            </div>
            <div class="tarif-price">
              <span class="price-amount">60€</span>
            </div>
          </div>

          <div class="tarif-card">
            <div class="tarif-destination">
              <strong>Digne → Sisteron</strong>
              <span class="tarif-distance">70 km - 1h</span>
            </div>
            <div class="tarif-price">
              <span class="price-amount">70€</span>
            </div>
          </div>

          <div class="tarif-card">
            <div class="tarif-destination">
              <strong>Digne → Forcalquier</strong>
              <span class="tarif-distance">65 km - 50 min</span>
            </div>
            <div class="tarif-price">
              <span class="price-amount">65€</span>
            </div>
          </div>

          <div class="tarif-card">
            <div class="tarif-destination">
              <strong>Digne → Marseille</strong>
              <span class="tarif-distance">150 km - 1h45</span>
            </div>
            <div class="tarif-price">
              <span class="price-amount">130€</span>
            </div>
          </div>

          <div class="tarif-card">
            <div class="tarif-destination">
              <strong>Digne → Gap</strong>
              <span class="tarif-distance">90 km - 1h30</span>
            </div>
            <div class="tarif-price">
              <span class="price-amount">90€</span>
            </div>
          </div>

          <div class="tarif-card">
            <div class="tarif-destination">
              <strong>Digne → Barcelonnette</strong>
              <span class="tarif-distance">85 km - 1h30</span>
            </div>
            <div class="tarif-price">
              <span class="price-amount">85€</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Tarifs horaires -->
      <div class="tarifs-section">
        <h3>Courses locales et mise à disposition</h3>
        <div class="tarifs-table">
          <table>
            <thead>
              <tr>
                <th>Service</th>
                <th>Tarif</th>
                <th>Description</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Course locale Digne</td>
                <td><strong>15-30€</strong></td>
                <td>Déplacements dans la ville et proches environs</td>
              </tr>
              <tr>
                <td>Mise à disposition 1h</td>
                <td><strong>45€</strong></td>
                <td>Véhicule et chauffeur à votre disposition</td>
              </tr>
              <tr>
                <td>Mise à disposition demi-journée</td>
                <td><strong>200€</strong></td>
                <td>4 heures consécutives</td>
              </tr>
              <tr>
                <td>Mise à disposition journée</td>
                <td><strong>350€</strong></td>
                <td>8 heures consécutives</td>
              </tr>
              <tr>
                <td>Transport médical</td>
                <td><strong>Remboursé</strong></td>
                <td>Selon prescription CPAM</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Informations tarifaires -->
      <div class="tarifs-info">
        <h3>Informations importantes sur nos tarifs</h3>

        <div class="info-grid">
          <div class="info-card">
            <h4>Suppléments éventuels</h4>
            <ul>
              <li>Nuit (20h-7h) : +20%</li>
              <li>Dimanche et jours fériés : +20%</li>
              <li>Bagages volumineux : +5€ par pièce</li>
              <li>Péage autoroutier : au réel</li>
              <li>Temps d'attente : 30€/heure</li>
            </ul>
          </div>

          <div class="info-card">
            <h4>Inclus dans nos tarifs</h4>
            <ul>
              <li>Prise en charge à domicile</li>
              <li>Bagages standards</li>
              <li>Véhicule propre et climatisé</li>
              <li>Chauffeur professionnel</li>
              <li>Suivi de vol (aéroport)</li>
            </ul>
          </div>

          <div class="info-card">
            <h4>Modes de paiement</h4>
            <ul>
              <li>Espèces</li>
              <li>Carte bancaire</li>
              <li>Chèques</li>
              <li>Facturation entreprise</li>
              <li>Tiers payant (transport médical)</li>
            </ul>
          </div>

          <div class="info-card">
            <h4>Nos garanties</h4>
            <ul>
              <li>Prix fixe annoncé à l'avance</li>
              <li>Pas de surprise à l'arrivée</li>
              <li>Devis gratuit et sans engagement</li>
              <li>Annulation gratuite 24h avant</li>
              <li>Facture détaillée fournie</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section confiance avec garanties visuelles -->
  <TrustSection
    title="Nos garanties tarifaires"
    subtitle="Des tarifs transparents, un service de qualité, une disponibilité totale"
    items={[
      {
        src: "/images/features/tarifs-transparents.webp",
        alt: "Tarifs transparents taxi Digne pas de frais cachés",
        caption: "Prix fixe annoncé à l'avance",
        description: "Pas de surprise à l'arrivée. Le tarif vous est communiqué avant la course et reste identique."
      },
      {
        src: "/images/about/certifications-licences.webp",
        alt: "Certifications professionnelles taxi agréé Digne",
        caption: "Chauffeurs professionnels agréés",
        description: "Tous nos chauffeurs sont titulaires de la carte professionnelle et respectent les tarifs réglementés."
      },
      {
        src: "/images/hero/hero-urgence-24h.webp",
        alt: "Service taxi disponible 24h/24 et 7j/7 Digne",
        caption: "Disponible 24h/24 et 7j/7",
        description: "Service d'urgence disponible jour et nuit, tous les jours de l'année, sans majoration excessive."
      }
    ]}
    variant="grid"
    bgColor="white"
  />

  <!-- Section comparaison modes de transport -->
  <section class="comparison-section">
    <div class="container">
      <h2>Pourquoi choisir un taxi professionnel plutôt qu'un VTC ou les transports en commun ?</h2>

      <div class="comparison-intro">
        <p>
          Face à la diversité des options de transport disponibles dans les Alpes-de-Haute-Provence,
          il est légitime de comparer les différentes solutions. Voici pourquoi le <strong>taxi professionnel</strong>
          reste le meilleur choix pour vos déplacements à Digne et dans le département.
        </p>
      </div>

      <div class="comparison-grid">
        <div class="comparison-card highlight">
          <h3>Taxi professionnel</h3>
          <div class="comparison-content">
            <ul class="advantages">
              <li><strong>Tarifs réglementés</strong> par la préfecture</li>
              <li><strong>Disponibilité immédiate</strong> 24h/24 sans réservation</li>
              <li><strong>Chauffeurs agréés</strong> avec carte professionnelle</li>
              <li><strong>Prise en charge garantie</strong> même en cas d'affluence</li>
              <li><strong>Connaissance locale</strong> parfaite du territoire</li>
              <li><strong>Stations dédiées</strong> dans toute la ville</li>
              <li><strong>Tarif fixe annoncé</strong> avant la course</li>
            </ul>
          </div>
        </div>

        <div class="comparison-card">
          <h3>VTC (Uber, etc.)</h3>
          <div class="comparison-content">
            <ul class="disadvantages">
              <li>Tarifs variables selon la demande (surge pricing)</li>
              <li>Disponibilité limitée en zone rurale</li>
              <li>Réservation obligatoire via application</li>
              <li>Pas de prise en charge en station</li>
              <li>Chauffeurs souvent non-locaux</li>
              <li>Service absent ou rare à Digne</li>
            </ul>
          </div>
        </div>

        <div class="comparison-card">
          <h3>Transports en commun</h3>
          <div class="comparison-content">
            <ul class="disadvantages">
              <li>Horaires fixes et limités</li>
              <li>Pas de service nocturne</li>
              <li>Correspondances nécessaires</li>
              <li>Temps de trajet très long</li>
              <li>Difficile avec bagages</li>
              <li>Réseau limité en zone rurale</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="comparison-conclusion">
        <h3>Le meilleur rapport qualité-prix pour vos déplacements</h3>
        <p>
          Le <strong>taxi professionnel à Digne</strong> offre le meilleur compromis entre flexibilité, confort,
          sécurité et prix. Contrairement aux VTC avec leurs tarifs fluctuants, nos prix sont <strong>transparents
          et réglementés</strong>. Contrairement aux transports en commun, nous vous offrons une <strong>disponibilité
          totale</strong> et un service porte-à-porte. Pour vos trajets vers l'aéroport, la gare ou vos courses
          locales, le taxi reste la solution la plus fiable et la plus économique dans les Alpes-de-Haute-Provence.
        </p>
      </div>
    </div>
  </section>

  <!-- Section réservation -->
  <section class="booking-section bg-light">
    <div class="container">
      <div class="booking-content">
        <div class="booking-text">
          <h2>Demandez votre devis gratuit</h2>
          <p>
            Remplissez notre formulaire pour obtenir un <strong>devis précis et personnalisé</strong>
            pour votre trajet. Réponse garantie sous 15 minutes.
          </p>

          <div class="booking-benefits">
            <h3>Avantages de la réservation anticipée</h3>
            <ul>
              <li>Tarif garanti sans surprise</li>
              <li>Disponibilité assurée même en période de forte affluence</li>
              <li>Choix du véhicule selon vos besoins (berline, monospace)</li>
              <li>Possibilité de demandes spécifiques (siège bébé, etc.)</li>
            </ul>
          </div>

          <div class="urgent-contact">
            <h3>Besoin urgent d'un taxi ?</h3>
            <p>Appelez-nous directement :</p>
            <a href="tel:+33123456789" class="urgent-phone">01 23 45 67 89</a>
            <p class="urgent-note">Disponible 24h/24 et 7j/7</p>
          </div>
        </div>

        <div class="booking-form-wrapper">
          <BookingForm />
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTA
    title="Besoin d'un devis personnalisé ?"
    subtitle="Chaque trajet est unique. Contactez-nous pour obtenir un tarif adapté à vos besoins spécifiques."
    buttonText="Demander un devis"
    phoneNumber="01 23 45 67 89"
  />

  <!-- SEO Content -->
  <section class="seo-content">
    <div class="container">
      <article class="seo-article">
        <h2>Tarifs de taxi transparents et compétitifs à Digne-les-Bains</h2>

        <p>
          Chez <strong>Taxi Digne</strong>, nous croyons en la transparence tarifaire. Tous nos
          <strong>tarifs de taxi</strong> vous sont communiqués avant chaque course, sans surprise à l'arrivée.
          Que vous ayez besoin d'un <strong>transfert vers l'aéroport de Marseille</strong>, d'un
          <strong>taxi pour la gare</strong> ou d'une simple course locale à Digne-les-Bains, vous connaissez
          le prix à l'avance.
        </p>

        <h3>Comment sont calculés nos tarifs de taxi ?</h3>

        <p>
          Nos <strong>tarifs de taxi à Digne</strong> sont calculés de manière juste et équitable, en fonction
          de plusieurs critères : la distance du trajet, l'horaire (jour, nuit, week-end), le type de véhicule
          nécessaire et d'éventuels suppléments (péages, bagages volumineux). Nous appliquons les tarifs réglementés
          par la préfecture des Alpes-de-Haute-Provence et nous nous engageons à vous proposer les meilleurs prix
          du marché.
        </p>

        <p>
          Pour obtenir un <strong>devis précis et gratuit</strong>, il vous suffit de nous contacter par téléphone
          ou d'utiliser notre formulaire de réservation en ligne. Nous vous répondons rapidement avec un tarif
          ferme et définitif, valable pour votre course.
        </p>

        <h3>Réservez au meilleur tarif</h3>

        <p>
          En réservant à l'avance, vous bénéficiez d'un <strong>tarif garanti</strong> et de la certitude
          d'avoir un véhicule disponible, même en période de forte demande. Notre service de réservation
          en ligne est simple, rapide et sécurisé. Vous pouvez également nous appeler 24h/24 au 01 23 45 67 89
          pour toute demande urgente ou question sur nos tarifs.
        </p>
      </article>
    </div>
  </section>

  <!-- FAQ Tarifs -->
  <FAQSection
    title="Questions fréquentes sur nos tarifs de taxi"
    subtitle="Tout ce que vous devez savoir sur nos prix, paiements et conditions"
    questions={tarifsFAQ}
    variant="list"
    bgColor="light"
  />

  <!-- Pages connexes -->
  <RelatedPages
    title="Découvrez nos autres pages"
    pages={relatedPages}
    columns={3}
  />
</Layout>

<style>
  .tarifs-hero {
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
    color: var(--color-white);
    padding: var(--spacing-xxl) 0;
    text-align: center;
  }

  .tarifs-hero h1 {
    color: var(--color-white);
    margin-bottom: var(--spacing-md);
  }

  .hero-text {
    font-size: 1.25rem;
    opacity: 0.95;
    max-width: 800px;
    margin: 0 auto;
  }

  .tarifs-main {
    padding: var(--spacing-xxl) 0;
  }

  .tarifs-intro {
    text-align: center;
    max-width: 800px;
    margin: 0 auto var(--spacing-xxl);
  }

  .tarifs-intro h2 {
    margin-bottom: var(--spacing-md);
  }

  .tarifs-intro p {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-gray-dark);
  }

  .tarifs-section {
    margin-bottom: var(--spacing-xxl);
  }

  .tarifs-section h3 {
    color: var(--color-primary);
    margin-bottom: var(--spacing-lg);
    text-align: center;
  }

  .tarifs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--spacing-md);
  }

  .tarif-card {
    background-color: var(--color-white);
    border: 2px solid var(--color-gray-light);
    border-radius: var(--border-radius-lg);
    padding: var(--spacing-lg);
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: var(--transition);
  }

  .tarif-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--box-shadow);
    transform: translateY(-2px);
  }

  .tarif-destination {
    flex: 1;
  }

  .tarif-destination strong {
    display: block;
    font-size: 1.125rem;
    margin-bottom: 0.25rem;
    color: var(--color-dark);
  }

  .tarif-distance {
    font-size: 0.9375rem;
    color: var(--color-gray);
  }

  .tarif-price {
    text-align: right;
  }

  .price-amount {
    display: block;
