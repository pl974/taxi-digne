---
/**
 * Page d'accueil - Optimisée conversion et SEO
 * Version améliorée avec images et nouveaux composants
 */

import Layout from '../layouts/Layout.astro';
import ImageHero from '../components/ImageHero.astro';
import TrustBadges from '../components/TrustBadges.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import FleetSection from '../components/FleetSection.astro';
import StatsCounter from '../components/StatsCounter.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import BookingForm from '../components/BookingForm.astro';
import CTA from '../components/CTA.astro';
import FAQSection from '../components/FAQSection.astro';

import {
  fleetVehicles,
  bookingSteps,
  mainFeatures,
  trustBadges,
  keyStats,
  servicesData,
  testimonials
} from '../data/siteData';

// FAQ essentielles pour homepage
const homepageFAQ = [
  {
    question: "Combien coûte un taxi de Digne-les-Bains à l'aéroport de Marseille ?",
    answer: "<p>Le tarif pour un <strong>transfert taxi Digne → Aéroport Marseille-Provence</strong> est de <strong>120€ pour 1-4 passagers</strong>. Le trajet dure environ 1h30. Ce tarif fixe inclut la prise en charge à domicile, l'assistance bagages et le suivi de vol en temps réel. <a href='/tarifs'>Voir tous nos tarifs</a></p>"
  },
  {
    question: "Acceptez-vous les réservations de nuit et le week-end ?",
    answer: "<p>Oui, notre service de taxi est disponible <strong>24 heures sur 24 et 7 jours sur 7</strong>, y compris les nuits, week-ends et jours fériés. Vous pouvez réserver en ligne à tout moment ou nous appeler au <strong>01 23 45 67 89</strong>. Un supplément de 20% s'applique pour les courses entre 20h et 7h.</p>"
  },
  {
    question: "Comment payer ma course de taxi ?",
    answer: "<p>Nous acceptons tous les modes de paiement : <strong>espèces, carte bancaire, chèques</strong> et pour les professionnels, la <strong>facturation mensuelle</strong>. Le paiement par carte bancaire est disponible directement dans le véhicule. Pour le transport médical conventionné, nous gérons le tiers payant avec la CPAM.</p>"
  },
  {
    question: "Puis-je réserver un taxi pour plusieurs personnes avec bagages ?",
    answer: "<p>Absolument ! Notre flotte comprend des <strong>véhicules de 4 à 8 places</strong> avec une grande capacité de coffre. Pour les groupes, nous proposons des monospaces et minibus. Précisez le nombre de passagers et de bagages lors de votre réservation pour que nous vous attribuions le véhicule adapté.</p>"
  },
  {
    question: "Quel est le délai de réservation nécessaire ?",
    answer: "<p>Pour une <strong>course immédiate</strong>, comptez 10-15 minutes en moyenne à Digne-les-Bains. Pour une <strong>réservation à l'avance</strong> (transfert aéroport, gare), nous recommandons de réserver au moins 24h avant. En haute saison, une réservation anticipée garantit votre place.</p>"
  }
];

const title = "Taxi à Digne-les-Bains et Alpes-de-Haute-Provence";
const description = "Réservez votre taxi à Digne-les-Bains. Service professionnel disponible 24h/24 et 7j/7. Transfert aéroport, gare, courses locales et longue distance. Devis gratuit en ligne.";
---

<Layout
  title={title}
  description={description}
  schemaType="LocalBusiness"
>
  <!-- Hero Section avec image -->
  <ImageHero
    title="Votre taxi à Digne-les-Bains"
    subtitle="Service de taxi professionnel disponible 24h/24 et 7j/7 dans les Alpes-de-Haute-Provence. Réservation en ligne simple et rapide avec devis immédiat."
    image="/images/hero/hero-taxi-digne-principal.webp"
    imageAlt="Taxi professionnel à Digne-les-Bains, service disponible 24h/24"
    ctaPrimary={{ text: "Appeler maintenant", href: "tel:+33123456789" }}
    ctaSecondary={{ text: "Réserver en ligne", href: "#booking" }}
    variant="full"
    height="large"
    overlay="gradient"
  />

  <!-- Badges de confiance -->
  <section class="trust-badges-section">
    <div class="container">
      <TrustBadges badges={trustBadges} layout="inline" variant="simple" />
    </div>
  </section>

  <!-- Section Services principaux avec images -->
  <section class="services-section">
    <div class="container">
      <div class="section-header">
        <h2>Nos services de taxi à Digne-les-Bains</h2>
        <p class="section-subtitle">
          Des solutions de transport adaptées à tous vos besoins dans les Alpes-de-Haute-Provence
        </p>
      </div>

      <div class="services-grid">
        {servicesData.map(service => (
          <article class="service-card-image">
            <div class="service-image">
              <img src={service.image} alt={service.title} loading="lazy" />
            </div>
            <div class="service-content">
              <h3>{service.title}</h3>
              <p>{service.description}</p>
              <div class="service-footer">
                <span class="service-price">{service.price}</span>
                <a href={service.link} class="service-link">En savoir plus →</a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="services-cta">
        <a href="/services" class="btn btn-primary btn-large">Voir tous nos services</a>
      </div>
    </div>
  </section>

  <!-- Section Features/Avantages avec images -->
  <FeatureGrid
    title="Pourquoi choisir notre service de taxi à Digne ?"
    subtitle="Plus de 15 ans d'expérience au service des habitants et visiteurs des Alpes-de-Haute-Provence"
    features={mainFeatures}
    columns={4}
    variant="image"
  />

  <!-- Section Expertise et expérience -->
  <section class="expertise-section">
    <div class="container">
      <div class="expertise-content">
        <div class="expertise-text">
          <h2>Plus de 15 ans d'expertise dans le transport de personnes</h2>
          <p>
            Depuis plus de 15 ans, notre entreprise de <strong>taxi à Digne-les-Bains</strong> s'est imposée comme
            une référence dans le transport de personnes dans les Alpes-de-Haute-Provence. Notre longue expérience
            nous a permis de développer une connaissance approfondie de la région, de ses routes et de ses spécificités.
          </p>
          <p>
            Tous nos chauffeurs sont <strong>titulaires de la carte professionnelle de taxi</strong>, obligatoire pour
            exercer ce métier. Ils suivent régulièrement des formations continues pour garantir votre sécurité et votre
            confort. Notre flotte de véhicules récents est entretenue selon les normes les plus strictes et fait l'objet
            de contrôles techniques réguliers.
          </p>
          <p>
            Nous sommes fiers d'avoir transporté des milliers de clients satisfaits, des habitants locaux aux touristes
            visitant notre belle région. Notre engagement envers la qualité de service et la ponctualité nous a valu
            une excellente réputation dans tout le département des Alpes-de-Haute-Provence.
          </p>
        </div>
        <div class="expertise-highlights">
          <div class="highlight-item">
            <h3>Certifications professionnelles</h3>
            <p>Tous nos chauffeurs sont titulaires de la carte professionnelle délivrée par la préfecture</p>
          </div>
          <div class="highlight-item">
            <h3>Formation continue</h3>
            <p>Formations régulières sur la sécurité, l'accueil client et la conduite défensive</p>
          </div>
          <div class="highlight-item">
            <h3>Flotte moderne</h3>
            <p>Véhicules récents, climatisés, entretenus et contrôlés régulièrement</p>
          </div>
          <div class="highlight-item">
            <h3>Assurance complète</h3>
            <p>Couverture maximale pour votre sécurité et votre tranquillité d'esprit</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section Process - Comment ça marche -->
  <section class="bg-light">
    <ProcessSteps
      title="Réservez votre taxi en 4 étapes simples"
      subtitle="Un processus de réservation facile et rapide pour tous vos déplacements"
      steps={bookingSteps}
      layout="horizontal"
    />
  </section>

  <!-- Section Flotte de véhicules -->
  <FleetSection
    title="Notre flotte de véhicules à Digne-les-Bains"
    subtitle="Des véhicules récents, confortables et parfaitement entretenus pour tous vos besoins de transport"
    vehicles={fleetVehicles}
  />

  <!-- Section Chiffres clés -->
  <StatsCounter
    title="Ils nous font confiance"
    subtitle="Des chiffres qui témoignent de notre engagement et de notre expertise"
    stats={keyStats}
    variant="primary"
  />

  <!-- Section Nos engagements qualité -->
  <section class="commitments-section bg-light">
    <div class="container">
      <div class="section-header">
        <h2>Nos engagements pour votre satisfaction</h2>
        <p class="section-subtitle">
          Des promesses tenues au quotidien pour vous garantir le meilleur service de taxi à Digne
        </p>
      </div>

      <div class="commitments-grid">
        <div class="commitment-card">
          <div class="commitment-icon">
            <img src="/images/features/ponctualite-garantie.webp" alt="Ponctualité garantie" loading="lazy" />
          </div>
          <h3>Ponctualité garantie</h3>
          <p>
            Nous nous engageons à être à l'heure pour chaque prise en charge. Pour vos transferts aéroport et gare,
            nous suivons les horaires de vol et de train en temps réel pour adapter notre arrivée en cas de retard.
            Votre temps est précieux, nous le respectons.
          </p>
        </div>

        <div class="commitment-card">
          <div class="commitment-icon">
            <img src="/images/features/tarifs-transparents.webp" alt="Tarifs transparents" loading="lazy" />
          </div>
          <h3>Tarifs transparents</h3>
          <p>
            Le prix vous est communiqué avant la course et reste fixe, sans surprise à l'arrivée. Pas de frais cachés,
            pas de détours inutiles. Nous privilégions toujours l'itinéraire le plus court et le plus rapide pour votre
            trajet. Tous nos tarifs sont consultables en ligne.
          </p>
        </div>

        <div class="commitment-card">
          <div class="commitment-icon">
            <img src="/images/features/confort-securite.webp" alt="Confort et sécurité" loading="lazy" />
          </div>
          <h3>Confort et sécurité</h3>
          <p>
            Nos véhicules sont récents, climatisés, parfaitement entretenus et nettoyés après chaque course.
            Tous nos chauffeurs sont formés à la conduite défensive et connaissent parfaitement la région.
            Votre sécurité est notre priorité absolue.
          </p>
        </div>

        <div class="commitment-card">
          <div class="commitment-icon">
            <img src="/images/features/disponibilite-totale.webp" alt="Disponibilité 24h/24" loading="lazy" />
          </div>
          <h3>Disponibilité totale</h3>
          <p>
            Notre service est disponible 24h/24 et 7j/7, y compris les jours fériés. Besoin d'un taxi en urgence
            à 3h du matin ? Transfert aéroport un dimanche ? Nous sommes là. Notre équipe de chauffeurs assure
            une couverture permanente sur Digne et les Alpes-de-Haute-Provence.
          </p>
        </div>

        <div class="commitment-card">
          <div class="commitment-icon">
            <img src="/images/about/satisfaction-client.webp" alt="Satisfaction client" loading="lazy" />
          </div>
          <h3>Service client réactif</h3>
          <p>
            Une question ? Un problème ? Notre service client vous répond rapidement par téléphone, SMS ou email.
            Nous traitons chaque demande avec attention et nous engageons à trouver une solution adaptée à vos besoins.
            Votre satisfaction est notre meilleure publicité.
          </p>
        </div>

        <div class="commitment-card">
          <div class="commitment-icon">
            <img src="/images/about/certifications-licences.webp" alt="Professionnalisme" loading="lazy" />
          </div>
          <h3>Professionnalisme</h3>
          <p>
            Courtoisie, discrétion et respect sont les maîtres-mots de nos chauffeurs. Nous adaptons notre service
            à vos besoins : besoin de silence pour travailler ? Conversation agréable ? Aide avec les bagages ?
            Nous sommes à votre écoute pour un service personnalisé.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section Zones desservies -->
  <section class="zones-section">
    <div class="container">
      <div class="section-header">
        <h2>Nos secteurs d'intervention dans les Alpes-de-Haute-Provence</h2>
        <p class="section-subtitle">
          Service de taxi couvrant l'ensemble du département 04 et les communes environnantes
        </p>
      </div>

      <div class="zones-content">
        <div class="zones-main">
          <h3>Principales villes desservies</h3>
          <ul class="zones-list">
            <li>
              <a href="/villes/digne-les-bains">
                <strong>Taxi Digne-les-Bains</strong> - Chef-lieu du département
              </a>
            </li>
            <li>
              <a href="/villes/manosque">
                <strong>Taxi Manosque</strong> - Ville dynamique du 04
              </a>
            </li>
            <li>
              <a href="/villes/sisteron">
                <strong>Taxi Sisteron</strong> - Perle de la Haute-Provence
              </a>
            </li>
            <li>
              <a href="/villes/forcalquier">
                <strong>Taxi Forcalquier</strong> - Cité médiévale
              </a>
            </li>
            <li>
              <a href="/villes/chateau-arnoux">
                <strong>Taxi Château-Arnoux-Saint-Auban</strong> - Zone industrielle
              </a>
            </li>
            <li>
              <a href="/villes/barcelonnette">
                <strong>Taxi Barcelonnette</strong> - Station de ski
              </a>
            </li>
          </ul>
        </div>

        <div class="zones-secondary">
          <h3>Autres communes desservies</h3>
          <div class="zones-columns">
            <ul>
              <li><a href="/villes">Oraison</a></li>
              <li><a href="/villes">Pierrevert</a></li>
              <li><a href="/villes">Volx</a></li>
              <li><a href="/villes">Les Mées</a></li>
            </ul>
            <ul>
              <li><a href="/villes">Peyruis</a></li>
              <li><a href="/villes">Mallemoisson</a></li>
              <li><a href="/villes">Aiglun</a></li>
              <li><a href="/villes">Malijai</a></li>
            </ul>
          </div>
          <p class="zones-note">
            <a href="/villes">Voir toutes les villes desservies →</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section Témoignages -->
  <section class="testimonials-section bg-light">
    <div class="container">
      <div class="section-header">
        <h2>Ce que disent nos clients</h2>
        <p class="section-subtitle">
          Des centaines de clients satisfaits nous font confiance pour leurs déplacements
        </p>
      </div>

      <div class="testimonials-grid">
        {testimonials.map(testimonial => (
          <TestimonialCard
            name={testimonial.name}
            rating={testimonial.rating}
            comment={testimonial.comment}
            city={testimonial.city}
            date={testimonial.date}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Section réservation avec formulaire -->
  <section id="booking" class="booking-section">
    <div class="container">
      <div class="booking-content">
        <div class="booking-info">
          <h2>Réservez votre taxi à Digne en quelques clics</h2>
          <p>
            Remplissez notre formulaire de réservation et recevez votre devis gratuit sous 15 minutes.
            Notre équipe vous recontacte rapidement pour confirmer votre course.
          </p>

          <div class="booking-advantages">
            <h3>Avantages de la réservation en ligne</h3>
            <ul>
              <li>Devis gratuit et sans engagement</li>
              <li>Réponse rapide garantie sous 15 minutes</li>
              <li>Tarif fixe connu à l'avance</li>
              <li>Paiement sécurisé en ligne ou à bord</li>
              <li>Confirmation par SMS et email</li>
            </ul>
          </div>

          <div class="booking-contact">
            <h3>Besoin d'un taxi immédiatement ?</h3>
            <p>Appelez-nous directement au</p>
            <a href="tel:+33123456789" class="phone-number">01 23 45 67 89</a>
            <p class="contact-note">Disponible 24h/24 et 7j/7</p>
          </div>
        </div>

        <div class="booking-form-wrapper">
          <BookingForm title="Demander un devis gratuit" />
        </div>
      </div>
    </div>
  </section>

  <!-- Section FAQ essentielles -->
  <FAQSection
    title="Questions fréquentes sur nos services de taxi à Digne"
    subtitle="Réponses rapides aux questions les plus posées par nos clients"
    questions={homepageFAQ}
    variant="list"
    bgColor="white"
  />

  <!-- CTA Final -->
  <CTA
    title="Besoin d'un taxi à Digne-les-Bains ?"
    subtitle="Contactez-nous dès maintenant pour réserver votre course ou obtenir un devis gratuit. Service professionnel disponible 24h/24."
    buttonText="Réserver maintenant"
    phoneNumber="01 23 45 67 89"
    variant="primary"
  />

  <!-- Section SEO - Contenu textuel riche -->
  <section class="seo-content">
    <div class="container">
      <article class="seo-article">
        <h2>Taxi à Digne-les-Bains : votre partenaire de confiance pour tous vos déplacements</h2>

        <p>
          Vous recherchez un <strong>taxi à Digne-les-Bains</strong> ou dans les <strong>Alpes-de-Haute-Provence</strong> ?
          Notre service de taxi professionnel vous accompagne pour tous vos déplacements, qu'ils soient personnels ou professionnels.
          Disponibles <strong>24h/24 et 7j/7</strong>, nos chauffeurs expérimentés vous garantissent un service de qualité,
          ponctuel et sécurisé.
        </p>

        <h3>Un service de taxi complet dans le département 04</h3>

        <p>
          Notre flotte de véhicules récents et climatisés est à votre disposition pour tous types de trajets :
          <strong>transfert aéroport</strong> vers Marseille, Nice ou Toulon, <strong>transfert gare</strong> SNCF,
          <strong>courses locales</strong> dans Digne et ses environs, <strong>transport médical conventionné</strong>,
          ou encore <strong>trajets longue distance</strong> vers toute la région PACA.
        </p>

        <p>
          Que vous soyez un particulier, un professionnel ou que vous ayez besoin d'un <strong>transport médical</strong>,
          nous adaptons notre service à vos besoins spécifiques. Nos tarifs transparents et compétitifs vous sont communiqués
          avant chaque course, sans surprise à l'arrivée.
        </p>

        <h3>Réservation de taxi simple et rapide à Digne</h3>

        <p>
          Réserver votre <strong>taxi à Digne-les-Bains</strong> n'a jamais été aussi simple. Utilisez notre formulaire
          de réservation en ligne disponible 24h/24, ou contactez-nous directement par téléphone au 01 23 45 67 89.
          Vous recevrez un <strong>devis gratuit</strong> sous 15 minutes et une confirmation de votre réservation
          par SMS et email.
        </p>

        <p>
          Notre service couvre l'ensemble des <strong>Alpes-de-Haute-Provence</strong> : Manosque, Sisteron, Forcalquier,
          Château-Arnoux, Barcelonnette, et de nombreuses autres communes du département 04. Pour vos déplacements
          professionnels, nous proposons également un service dédié aux entreprises avec facturation mensuelle.
        </p>

        <h3>Des chauffeurs professionnels et expérimentés</h3>

        <p>
          Tous nos chauffeurs sont des <strong>professionnels qualifiés</strong>, titulaires de la carte professionnelle
          de taxi et parfaitement formés. Ils connaissent parfaitement la région des Alpes-de-Haute-Provence et ses routes,
          vous garantissant ainsi un trajet optimal et sécurisé. Courtois et discrets, ils sauront répondre à toutes
          vos demandes avec professionnalisme.
        </p>

        <p>
          Faites confiance à notre expérience de plus de 15 ans dans le <strong>transport de personnes à Digne</strong>
          et ses environs. Rejoignez les centaines de clients qui nous font déjà confiance pour leurs déplacements
          quotidiens dans les Alpes-de-Haute-Provence.
        </p>
      </article>
    </div>
  </section>
</Layout>

<style>
  /* Trust Badges Section */
  .trust-badges-section {
    background-color: var(--color-light);
    padding: var(--spacing-lg) 0;
    border-bottom: 1px solid var(--color-gray-light);
  }

  /* Section Headers */
  .section-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto var(--spacing-xl);
  }

  .section-header h2 {
    margin-bottom: var(--spacing-md);
  }

  .section-subtitle {
    font-size: 1.125rem;
    color: var(--color-gray-dark);
    line-height: 1.6;
  }

  /* Services Section */
  .services-section {
    padding: var(--spacing-xxl) 0;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
  }

  .service-card-image {
    background-color: var(--color-white);
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    box-shadow: var(--box-shadow);
    transition: var(--transition);
    display: flex;
    flex-direction: column;
  }

  .service-card-image:hover {
    box-shadow: var(--box-shadow-lg);
    transform: translateY(-4px);
  }

  .service-image {
    width: 100%;
    height: 200px;
    overflow: hidden;
  }

  .service-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .service-card-image:hover .service-image img {
    transform: scale(1.05);
  }

  .service-content {
    padding: var(--spacing-lg);
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .service-content h3 {
    font-size: 1.25rem;
    margin-bottom: var(--spacing-sm);
    color: var(--color-dark);
  }

  .service-content p {
    color: var(--color-gray-dark);
    line-height: 1.6;
    flex-grow: 1;
    margin-bottom: var(--spacing-md);
  }

  .service-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--spacing-sm);
    border-top: 1px solid var(--color-gray-light);
  }

  .service-price {
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
    font-size: 1.125rem;
  }

  .service-link {
    color: var(--color-primary);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  .service-link:hover {
    color: var(--color-primary-dark);
  }

  .services-cta {
    text-align: center;
  }

  /* Zones Section */
  .zones-section {
    padding: var(--spacing-xxl) 0;
  }

  .zones-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-xl);
  }

  .zones-main h3,
  .zones-secondary h3 {
    color: var(--color-primary);
    margin-bottom: var(--spacing-md);
  }

  .zones-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .zones-list li {
    padding: var(--spacing-sm);
    background-color: var(--color-light);
    border-radius: var(--border-radius);
    transition: var(--transition);
  }

  .zones-list li:hover {
    background-color: var(--color-primary-light);
    transform: translateX(8px);
  }

  .zones-list li:hover a {
    color: var(--color-white);
  }

  .zones-list a {
    color: var(--color-dark);
    text-decoration: none;
  }

  .zones-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
