---
/**
 * Page Taxi Forcalquier - Page locale optimisée SEO
 * Cité médiévale et capitale du pays de Haute-Provence
 */

import Layout from '../../layouts/Layout.astro';
import ImageHero from '../../components/ImageHero.astro';
import BookingForm from '../../components/BookingForm.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CTA from '../../components/CTA.astro';

const title = "Taxi Forcalquier 24h/24";
const description = "Réservez votre taxi à Forcalquier. Service professionnel disponible 24h/24. Transfert aéroport, gare, marché provençal. Devis gratuit. Appelez le 01 23 45 67 89.";
---

<Layout
  title={title}
  description={description}
  keywords="taxi forcalquier, taxi 04300, réservation taxi forcalquier, transport forcalquier, VTC forcalquier, taxi cite medievale"
>
  <!-- Hero Section locale -->
  <ImageHero
    title="Taxi à Forcalquier : service 24h/24 dans la cité médiévale"
    subtitle="Service de taxi professionnel dans la capitale du pays de Haute-Provence. Réservation rapide pour tous vos déplacements vers Manosque, Digne, Apt et Avignon."
    image="/images/villes/alpes-haute-provence-paysage.webp"
    imageAlt="Taxi professionnel à Forcalquier, cité médiévale de Haute-Provence"
    ctaPrimary={{ text: "Appelez maintenant", href: "tel:+33123456789" }}
    ctaSecondary={{ text: "Réserver en ligne", href: "#booking" }}
    variant="full"
    height="medium"
    overlay="dark"
  />

  <!-- Informations sur Forcalquier -->
  <section class="city-info">
    <div class="container">
      <div class="info-grid">
        <div class="info-main">
          <h2>Service de taxi à Forcalquier et dans le pays de Haute-Provence</h2>

          <p>
            <strong>Taxi Forcalquier</strong> vous propose un service de transport professionnel dans toute la ville
            et sa région. Que vous soyez dans le <strong>centre historique</strong>, à la <strong>Citadelle</strong>,
            au <strong>Couvent des Cordeliers</strong>, à <strong>Mane</strong>, <strong>Lurs</strong> ou dans les
            nombreux villages du pays de Haute-Provence, nous intervenons rapidement pour tous vos besoins de déplacement.
          </p>

          <p>
            Forcalquier, ville de 5 000 habitants, est l'ancienne capitale du comté de Forcalquier. Cette <strong>cité
            médiévale</strong> au riche patrimoine historique et culturel attire de nombreux visiteurs. Son célèbre
            <strong>marché provençal</strong> du lundi, l'un des plus beaux de Provence, ainsi que ses événements culturels
            font de Forcalquier un pôle touristique important. Notre <strong>service de taxi à Forcalquier</strong> répond
            aux besoins des résidents, touristes et professionnels.
          </p>

          <h3>Nos services de taxi à Forcalquier</h3>

          <ul class="services-list">
            <li>
              <strong>Taxi marché de Forcalquier</strong> - Service spécial le lundi pour le marché provençal,
              transport de courses et retour à domicile
            </li>
            <li>
              <strong>Transfert aéroport</strong> - Transport vers les aéroports de Marseille-Provence (1h15),
              Nice (2h30) et Avignon (1h30)
            </li>
            <li>
              <strong>Taxi vers Manosque</strong> - Liaison quotidienne vers Manosque (25 min), idéal pour
              rendez-vous professionnels ou médicaux
            </li>
            <li>
              <strong>Taxi vers Apt et Avignon</strong> - Desserte régulière vers le Luberon et le Vaucluse
            </li>
            <li>
              <strong>Courses locales</strong> - Déplacements dans Forcalquier et villages environnants : Mane,
              Lurs, Niozelles, Saint-Michel-l'Observatoire, Reillanne
            </li>
            <li>
              <strong>Transport médical</strong> - Service conventionné CPAM pour vos rendez-vous médicaux à
              Forcalquier, Manosque ou Digne
            </li>
            <li>
              <strong>Taxi touristique</strong> - Découverte du patrimoine de Forcalquier et du pays de
              Haute-Provence, circuits personnalisés
            </li>
          </ul>

          <h3>Points d'intérêt et destinations à Forcalquier</h3>

          <p>
            Notre service de <strong>taxi à Forcalquier</strong> vous emmène vers tous les sites remarquables
            de la ville et de sa région :
          </p>

          <ul class="destinations-list">
            <li><strong>Citadelle de Forcalquier</strong> - Notre-Dame-de-Provence et panorama exceptionnel</li>
            <li><strong>Couvent des Cordeliers</strong> - Monument historique et centre culturel</li>
            <li><strong>Marché provençal</strong> - Tous les lundis matin, l'un des plus beaux de Provence</li>
            <li><strong>Cathédrale Notre-Dame-du-Bourguet</strong> - Architecture gothique provençal</li>
            <li><strong>Musée municipal</strong> - Histoire et patrimoine forcalquiéren</li>
            <li><strong>Observatoire de Haute-Provence</strong> - Saint-Michel-l'Observatoire (proximité)</li>
            <li><strong>Prieuré de Salagon</strong> - Musée et jardins ethnobotaniques</li>
            <li><strong>Jardin des Cordeliers</strong> - Jardin remarquable</li>
          </ul>

          <h3>Liaisons depuis Forcalquier</h3>

          <div class="routes-info">
            <div class="route-card">
              <h4>Vers les aéroports</h4>
              <ul>
                <li>Taxi Forcalquier → Aéroport Marseille : 1h15 - à partir de 95€</li>
                <li>Taxi Forcalquier → Aéroport Nice : 2h30 - à partir de 150€</li>
                <li>Taxi Forcalquier → Aéroport Avignon : 1h30 - à partir de 100€</li>
                <li>Taxi Forcalquier → Aix TGV : 1h - à partir de 85€</li>
              </ul>
            </div>

            <div class="route-card">
              <h4>Vers les villes principales</h4>
              <ul>
                <li>Taxi Forcalquier → Manosque : 25 min - à partir de 35€</li>
                <li>Taxi Forcalquier → Digne-les-Bains : 50 min - à partir de 65€</li>
                <li>Taxi Forcalquier → Apt : 40 min - à partir de 55€</li>
                <li>Taxi Forcalquier → Sisteron : 45 min - à partir de 60€</li>
                <li>Taxi Forcalquier → Avignon : 1h30 - à partir de 100€</li>
                <li>Taxi Forcalquier → Aix-en-Provence : 1h - à partir de 85€</li>
              </ul>
            </div>

            <div class="route-card">
              <h4>Villages du pays de Forcalquier</h4>
              <ul>
                <li>Taxi Forcalquier → Mane : 5 min - à partir de 15€</li>
                <li>Taxi Forcalquier → Lurs : 15 min - à partir de 25€</li>
                <li>Taxi Forcalquier → Saint-Michel-Observatoire : 10 min - à partir de 20€</li>
                <li>Taxi Forcalquier → Reillanne : 20 min - à partir de 30€</li>
                <li>Taxi Forcalquier → Banon : 25 min - à partir de 35€</li>
              </ul>
            </div>
          </div>

          <h3>Forcalquier, capitale culturelle du pays de Haute-Provence</h3>

          <p>
            <strong>Forcalquier</strong> est une ville au patrimoine exceptionnel, ancienne capitale du comté de
            Forcalquier au Moyen Âge. La ville rayonne aujourd'hui comme pôle culturel avec ses nombreux festivals,
            son marché provençal réputé et ses monuments historiques. Le <strong>Couvent des Cordeliers</strong>,
            classé monument historique, accueille concerts et expositions. La <strong>Citadelle</strong> et sa
            chapelle Notre-Dame-de-Provence offrent un panorama à 360° sur les Alpes de Haute-Provence.
          </p>

          <p>
            Notre <strong>service de taxi</strong> est particulièrement adapté aux besoins des touristes découvrant
            la région. Nous proposons des circuits touristiques personnalisés vers les villages perchés du Luberon,
            les champs de lavande du plateau de Valensole, ou l'Observatoire de Haute-Provence. Pour les résidents,
            nous assurons les liaisons quotidiennes vers Manosque, Digne et Apt.
          </p>
        </div>

        <aside class="info-sidebar">
          <div class="booking-widget">
            <BookingForm title="Réserver un taxi à Forcalquier" compact={true} />
          </div>

          <div class="contact-widget">
            <h3>Contactez-nous</h3>
            <p>Service disponible 24h/24 et 7j/7</p>
            <a href="tel:+33123456789" class="phone-link">01 23 45 67 89</a>
            <p class="contact-info">
              Réponse rapide garantie<br />
              Devis gratuit sans engagement
            </p>
          </div>

          <div class="zones-widget">
            <h3>Autres villes desservies</h3>
            <ul>
              <li><a href="/villes/digne-les-bains">Taxi Digne-les-Bains</a></li>
              <li><a href="/villes/manosque">Taxi Manosque</a></li>
              <li><a href="/villes/sisteron">Taxi Sisteron</a></li>
              <li><a href="/villes/chateau-arnoux">Taxi Château-Arnoux</a></li>
              <li><a href="/villes/barcelonnette">Taxi Barcelonnette</a></li>
              <li><a href="/villes">Voir toutes les villes</a></li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Section Services Cards -->
  <section class="services-section bg-light">
    <div class="container">
      <h2 class="text-center">Nos services de taxi à Forcalquier</h2>
      <div class="services-grid">
        <ServiceCard
          title="Taxi marché Forcalquier"
          description="Service spécial le lundi pour le marché provençal. Transport de courses inclus."
          price="20€"
        />
        <ServiceCard
          title="Taxi Forcalquier - Manosque"
          description="Liaison quotidienne vers Manosque en 25 minutes. Service professionnel."
          price="35€"
        />
        <ServiceCard
          title="Circuits touristiques"
          description="Découvrez Forcalquier et le pays de Haute-Provence avec chauffeur-guide."
          price="Sur devis"
        />
      </div>
    </div>
  </section>

  <!-- Formulaire de réservation -->
  <section id="booking" class="booking-section">
    <div class="container">
      <div class="booking-centered">
        <h2 class="text-center">Réservez votre taxi à Forcalquier</h2>
        <p class="text-center section-subtitle">
          Remplissez le formulaire ci-dessous et recevez votre devis gratuit sous 15 minutes
        </p>
        <div class="booking-form-large">
          <BookingForm />
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTA
    title="Besoin d'un taxi à Forcalquier maintenant ?"
    subtitle="Appelez-nous ou réservez en ligne pour un service rapide vers Manosque, Digne, Apt ou les aéroports"
    buttonText="Appeler maintenant"
    phoneNumber="01 23 45 67 89"
  />

  <!-- Contenu SEO -->
  <section class="seo-content">
    <div class="container">
      <article class="seo-article">
        <h2>Pourquoi choisir notre service de taxi à Forcalquier ?</h2>

        <p>
          Notre entreprise de <strong>taxi à Forcalquier</strong> connaît parfaitement cette magnifique <strong>cité
          médiévale</strong> et tout le pays de Haute-Provence depuis plus de 15 ans. Que vous ayez besoin d'un
          <strong>taxi pour le marché de Forcalquier</strong>, d'un <strong>transfert vers Manosque</strong> ou
          d'un transport vers l'aéroport, nos chauffeurs professionnels sont à votre disposition <strong>24 heures
          sur 24 et 7 jours sur 7</strong>.
        </p>

        <h3>Un service adapté au rythme de Forcalquier</h3>

        <p>
          Forcalquier vit au rythme de son célèbre <strong>marché provençal du lundi</strong>, l'un des plus beaux
          de Provence. Notre <strong>service de taxi</strong> propose un service spécial marché avec transport de
          courses et retour à domicile. Nous desservons également tous les événements culturels de la ville : festivals,
          concerts au Couvent des Cordeliers, expositions et manifestations.
        </p>

        <p>
          Notre flotte de véhicules confortables est adaptée aux besoins variés : courses locales, liaisons vers
          Manosque ou Apt, transferts aéroport, circuits touristiques. Tous nos chauffeurs connaissent parfaitement
          la région et ses villages pittoresques : Mane, Lurs, Reillanne, Banon, Saint-Michel-l'Observatoire.
        </p>

        <h3>Réservation simple et tarifs transparents</h3>

        <p>
          Réserver un <strong>taxi à Forcalquier</strong> est très simple. Contactez-nous par téléphone au
          01 23 45 67 89 ou utilisez notre formulaire en ligne disponible 24h/24. Nous vous répondons rapidement
          avec un <strong>devis gratuit et sans engagement</strong>. Le prix fixe vous est communiqué avant la course,
          sans surprise à l'arrivée. Nous acceptons tous les modes de paiement pour votre confort.
        </p>
      </article>
    </div>
  </section>
</Layout>

<style>
  /* Styles identiques aux autres pages villes */
  .city-info {
    padding: var(--spacing-xxl) 0;
  }

  .info-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--spacing-xl);
  }

  .info-main h2 {
    margin-bottom: var(--spacing-md);
  }

  .info-main h3 {
    margin-top: var(--spacing-lg);
    margin-bottom: var(--spacing-md);
    color: var(--color-primary);
  }

  .info-main h4 {
    margin-bottom: var(--spacing-sm);
  }

  .info-main p {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: var(--spacing-md);
  }

  .services-list,
  .destinations-list {
    list-style: none;
    padding: 0;
    margin-bottom: var(--spacing-lg);
  }

  .services-list li,
  .destinations-list li {
    padding: var(--spacing-sm) 0;
    padding-left: 1.5rem;
    position: relative;
    line-height: 1.6;
  }

  .services-list li::before,
  .destinations-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: bold;
  }

  .routes-info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--spacing-md);
    margin-top: var(--spacing-lg);
  }

  .route-card {
    background-color: var(--color-light);
    padding: var(--spacing-lg);
    border-radius: var(--border-radius-lg);
    border-left: 4px solid var(--color-primary);
  }

  .route-card ul {
    list-style: none;
    padding: 0;
    margin-top: var(--spacing-sm);
  }

  .route-card li {
    padding: 0.5rem 0;
    color: var(--color-gray-dark);
  }

  .info-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .booking-widget,
  .contact-widget,
  .zones-widget {
    background-color: var(--color-white);
    padding: var(--spacing-lg);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--box-shadow);
  }

  .contact-widget {
    text-align: center;
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
    color: var(--color-white);
  }

  .contact-widget h3 {
    color: var(--color-white);
    margin-bottom: var(--spacing-sm);
  }

  .contact-widget p {
    color: var(--color-white);
    margin-bottom: var(--spacing-sm);
  }

  .phone-link {
    display: block;
    font-size: 1.75rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-secondary);
    text-decoration: none;
    margin: var(--spacing-md) 0;
  }

  .contact-info {
    font-size: 0.9375rem;
    opacity: 0.9;
  }

  .zones-widget h3 {
    margin-bottom: var(--spacing-md);
  }

  .zones-widget ul {
    list-style: none;
    padding: 0;
  }

  .zones-widget li {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-gray-light);
  }

  .zones-widget li:last-child {
    border-bottom: none;
  }

  .zones-widget a {
    color: var(--color-primary);
    font-weight: var(--font-weight-medium);
  }

  .services-section {
    padding: var(--spacing-xxl) 0;
  }

  .services-section h2 {
    margin-bottom: var(--spacing-xl);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--spacing-lg);
  }

  .booking-section {
    padding: var(--spacing-xxl) 0;
    background-color: var(--color-light);
  }

  .booking-centered {
    max-width: 800px;
    margin: 0 auto;
  }

  .booking-form-large {
    margin-top: var(--spacing-lg);
  }

  .seo-content {
    padding: var(--spacing-xxl) 0;
  }

  .seo-article {
    max-width: 900px;
    margin: 0 auto;
  }

  .seo-article h2 {
    margin-bottom: var(--spacing-lg);
  }

  .seo-article h3 {
    margin-top: var(--spacing-lg);
    margin-bottom: var(--spacing-md);
  }

  .seo-article p {
    font-size: 1.0625rem;
    line-height: 1.8;
    margin-bottom: var(--spacing-md);
  }

  @media (max-width: 968px) {
    .info-grid {
      grid-template-columns: 1fr;
    }

    .info-sidebar {
      order: -1;
    }

    .routes-info {
      grid-template-columns: 1fr;
    }
  }
</style>
